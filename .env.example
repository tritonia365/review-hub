# Copy this file to .env (same folder) and fill in your own key.
# .env is git-ignored — it will never be committed.
#
# Where to get a key: https://developers.kakao.com/ -> my Application -> App Keys -> REST API Key
#
# index.html fetches this file at load time (fetch("./.env")) and parses this
# KEY=VALUE line directly in the browser — it only works when the page is
# served over http(s):// (a static file server is fine); opening index.html
# via file:// blocks the fetch, and the page silently falls back to the
# on-page "#rt-search-keysetup" prompt (localStorage rt_kakao_key) instead.

KAKAO_REST_API_KEY=여기에_REST_API_키_입력
