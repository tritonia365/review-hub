# Copy this file to .env (same folder) and fill in your own key.
# .env is git-ignored — it will never be committed.
#
# Where to get a key: https://developers.kakao.com/ -> my Application -> App Keys -> REST API Key
#
# This key is only ever read server-side, by the Vercel serverless function
# at api/search.js (process.env.KAKAO_REST_API_KEY) — the browser/client
# never sees it. index.html's search UI calls the same-origin /api/search
# endpoint instead of Kakao directly.
#
# Local dev: running `vercel dev` reads this .env file automatically and
# fills process.env for api/search.js — no extra setup needed.
#
# Deploying to Vercel: the .env file itself is NOT included in the deployment
# (it's git-ignored, and Vercel builds from git). You must register this same
# value in the Vercel dashboard: Project -> Settings -> Environment Variables,
# add a variable named exactly KAKAO_REST_API_KEY with your real key as the
# value, then redeploy (or trigger a new deployment) for it to take effect.

KAKAO_REST_API_KEY=여기에_REST_API_키_입력

# Where to get a key: https://console.cloud.google.com/ -> APIs & Services ->
# enable "Places API (New)" (NOT the legacy "Places API") -> Credentials ->
# create an API key.
#
# This key is only ever read server-side, by the Vercel serverless function
# at api/reviews.js (process.env.GOOGLE_PLACES_API_KEY) — the browser/client
# never sees it. index.html's review panel calls the same-origin /api/reviews
# endpoint instead of Google directly.
#
# Local dev: running `vercel dev` reads this .env file automatically and
# fills process.env for api/reviews.js — no extra setup needed.
#
# Deploying to Vercel: just like KAKAO_REST_API_KEY above, register this value
# in the Vercel dashboard: Project -> Settings -> Environment Variables, add a
# variable named exactly GOOGLE_PLACES_API_KEY with your real key as the
# value, then redeploy (or trigger a new deployment) for it to take effect.

GOOGLE_PLACES_API_KEY=여기에_Google_Places_API_키_입력

# Where to get a key: https://aistudio.google.com/apikey (Google AI Studio).
#
# This key is only ever read server-side, by the Vercel serverless function
# at api/analyze.js (process.env.GEMINI_API_KEY) — the browser/client never
# sees it. index.html's review panel calls the same-origin /api/analyze
# endpoint instead of Gemini directly, sending it only the review text
# already fetched via /api/reviews.
#
# Local dev: running `vercel dev` reads this .env file automatically and
# fills process.env for api/analyze.js — no extra setup needed.
#
# Deploying to Vercel: just like the keys above, register this value in the
# Vercel dashboard: Project -> Settings -> Environment Variables, add a
# variable named exactly GEMINI_API_KEY with your real key as the value,
# then redeploy (or trigger a new deployment) for it to take effect.

GEMINI_API_KEY=여기에_Gemini_API_키_입력

# Supabase project: https://qpeyzjsmikuchthtntjq.supabase.co
#
# Unlike the keys above, the Supabase URL + anon/publishable key are NOT
# proxied through a Vercel function — they're hardcoded directly into
# index.html's inline <script> and shipped to the browser. That's the
# normal Supabase pattern: the anon key is meant to be public, and RLS
# (not key secrecy) is what protects the data. These .env entries exist
# only for local reference / a future build step, not because any
# api/*.js file currently reads them.
#
# No tables exist in this project yet and no RLS policies are defined —
# only the client connection is wired up (see index.html's "Supabase
# client" block). Don't query real tables from the client until RLS is
# in place (PRD_1.md §17.4).

SUPABASE_URL=https://qpeyzjsmikuchthtntjq.supabase.co
SUPABASE_ANON_KEY=여기에_anon_또는_publishable_키_입력

# Get this from: Supabase Dashboard -> Project Settings -> API -> Project API
# keys -> service_role (click "Reveal"). This key bypasses Row Level Security
# entirely, so it must NEVER be shipped to the browser or committed anywhere.
#
# It is only ever read server-side, by the Vercel serverless function at
# api/delete-account.js (process.env.SUPABASE_SERVICE_ROLE_KEY), which uses
# it to call Supabase's Auth Admin API and delete the calling user's own
# account (self-service account deletion — "마이페이지" -> "회원 탈퇴").
#
# Local dev: running `vercel dev` reads this .env file automatically and
# fills process.env for api/delete-account.js — no extra setup needed.
#
# Deploying to Vercel: register this value in the Vercel dashboard: Project
# -> Settings -> Environment Variables, add a variable named exactly
# SUPABASE_SERVICE_ROLE_KEY with the real key as the value, then redeploy.

SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키_입력

# Used by .mcp.json to run the official Supabase MCP server, scoped to this
# project only (--project-ref=qpeyzjsmikuchthtntjq, --read-only). This lets
# Claude Code query/inspect this project directly in future sessions.
#
# Get a personal access token: https://supabase.com/dashboard/account/tokens
#
# IMPORTANT: .mcp.json's "${SUPABASE_ACCESS_TOKEN}" is expanded from your
# actual shell/OS environment variables, NOT read from this .env file. Set
# it as a real env var (PowerShell: $env:SUPABASE_ACCESS_TOKEN = "...", or
# add it permanently via System Properties > Environment Variables) before
# starting Claude Code, then restart Claude Code for the MCP server to pick
# it up. Never commit the real token anywhere.

SUPABASE_ACCESS_TOKEN=여기에_personal_access_token_입력
